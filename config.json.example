{
  "command": "pi",
  "args": [
    "-p",
    "--no-session",
    "--append-system-prompt",
    "{system_prompt}",
    "{task}"
  ],
  "prompt_dir": "",
  "state_dir": "",
  "worktree_parent": "../{repo}.worktrees",
  "agent_timeout": "60m",
  "monitor_timeout": "",
  "pipeline_checks": [
    ["make", "test"]
  ],
  "parallel_implementation": {
    "enabled": false,
    "max_concurrency": 4
  }
}
